{
  "name": "uni-application-hub",
  "version": "1.0.0",
  "description": "Desktop manager for university applications: deadlines, encrypted portal logins, documents and an embedded browser workspace.",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.unihub",
    "productName": "Application Hub",
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.education" }
  }
}
